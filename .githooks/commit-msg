#!/bin/sh
# ============================================================
# commit-msg 钩子：Conventional Commits 格式校验 + scope 一致性校验
# 安装: sh .githooks/install.sh   临时跳过: SKIP_COMMIT_CHECK=1 git commit ...
# ============================================================
[ "$SKIP_COMMIT_CHECK" = "1" ] && exit 0

MSG_FILE="$1"
HEAD_LINE=$(head -n 1 "$MSG_FILE")
case "$HEAD_LINE" in
  Merge\ *) exit 0 ;;
  Revert\ *) exit 0 ;;
  fixup!*) exit 0 ;;
  squash!*) exit 0 ;;
esac

GITDIR=$(git rev-parse --git-dir)
node "$GITDIR/../.githooks/commit-msg.mjs" "$MSG_FILE" "$GITDIR" || exit 1
