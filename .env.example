# 环境变量模板（复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交）
# ── 数据库（MySQL）──
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
# 真实数据库密码（必填，缺失后端无法启动）
DB_PASSWORD=

# ── JWT ──
# HS256 要求 ≥32 字节随机串，生成命令：
#   openssl rand -base64 32
# 真实密钥（必填，缺失后端无法启动）
JWT_SECRET=
# Token 有效期（毫秒），默认 24 小时
JWT_EXPIRE_MS=86400000

# ── 微信小程序（可选：仅使用小程序端登录时才需要）──
# 小程序 AppID；只用 Web 端可留空，不影响后端启动
WECHAT_APPID=
# 小程序 AppSecret；只用 Web 端可留空，不影响后端启动
WECHAT_SECRET=
