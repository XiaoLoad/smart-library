# 后端环境变量模板：复制本文件为 backend/.env 并填入真实值
# .env 已被 .gitignore 忽略，不会被提交；后端启动时自动读取（见 application.yml 的 spring.config.import）
# 注意：properties 格式的注释必须独占一行，不能写在行尾

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
# 必填：MySQL 密码（缺失时后端拒绝启动）
DB_PASSWORD=

# ===== JWT =====
# 必填：HS256 签名密钥，需 32 字节以上随机串。生成示例：openssl rand -base64 48
JWT_SECRET=
# Token 有效期（毫秒），默认 24 小时
JWT_EXPIRE_MS=86400000

# ===== 微信小程序 =====
# 不使用小程序登录可整体留空，不影响启动（调用小程序登录接口时返回"未配置"提示）
WECHAT_APPID=
WECHAT_SECRET=
