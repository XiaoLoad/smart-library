<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.AiMessageMapper">

    <resultMap id="msgMap" type="com.library.entity.AiMessage">
        <id property="id" column="id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByConversationId" resultMap="msgMap">
        SELECT * FROM ai_messages
        WHERE conversation_id = #{conversationId}
        ORDER BY create_time ASC
    </select>

    <insert id="insert" parameterType="com.library.entity.AiMessage" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_messages (conversation_id, role, content, create_time)
        VALUES (#{conversationId}, #{role}, #{content}, #{createTime})
    </insert>

    <delete id="deleteByConversationId">
        DELETE FROM ai_messages WHERE conversation_id = #{conversationId}
    </delete>

</mapper>
