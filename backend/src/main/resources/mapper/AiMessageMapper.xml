<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.AiMessageMapper">

    <resultMap id="msgMap" type="com.library.entity.AiMessage">
        <id property="id" column="id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="toolSummary" column="tool_summary"/>
        <result property="toolSnapshots" column="tool_snapshots"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByConversationId" resultMap="msgMap">
        SELECT * FROM ai_messages
        WHERE conversation_id = #{conversationId}
        ORDER BY create_time ASC
    </select>

    <!-- 窗口分页：beforeId 为空取最新一页（id 倒序），否则取更早一页 -->
    <select id="selectHistoryPage" resultMap="msgMap">
        SELECT * FROM ai_messages
        WHERE conversation_id = #{conversationId}
        <if test="beforeId != null">
            AND id &lt; #{beforeId}
        </if>
        ORDER BY id DESC
        LIMIT #{pageSize}
    </select>

    <select id="countByConversationId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM ai_messages WHERE conversation_id = #{conversationId}
    </select>

    <insert id="insert" parameterType="com.library.entity.AiMessage" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_messages (conversation_id, role, content, tool_summary, tool_snapshots, create_time)
        VALUES (#{conversationId}, #{role}, #{content}, #{toolSummary}, #{toolSnapshots}, #{createTime})
    </insert>

    <delete id="deleteByConversationId">
        DELETE FROM ai_messages WHERE conversation_id = #{conversationId}
    </delete>

</mapper>
