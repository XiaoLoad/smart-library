<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.NotificationRuleMapper">

    <resultMap id="ruleMap" type="com.library.entity.NotificationRule">
        <id property="id" column="id"/>
        <result property="eventType" column="event_type"/>
        <result property="channel" column="channel"/>
        <result property="enabled" column="enabled"/>
        <result property="offsetDays" column="offset_days"/>
        <result property="subjectTpl" column="subject_tpl"/>
        <result property="bodyTpl" column="body_tpl"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectAll" resultMap="ruleMap">
        SELECT * FROM notification_rule ORDER BY id
    </select>

    <select id="selectByEventType" resultMap="ruleMap">
        SELECT * FROM notification_rule WHERE event_type = #{eventType}
    </select>

    <insert id="upsert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notification_rule (event_type, channel, enabled, offset_days, subject_tpl, body_tpl)
        VALUES (#{eventType}, #{channel}, #{enabled}, #{offsetDays}, #{subjectTpl}, #{bodyTpl})
        ON DUPLICATE KEY UPDATE
            channel = VALUES(channel),
            enabled = VALUES(enabled),
            offset_days = VALUES(offset_days),
            subject_tpl = VALUES(subject_tpl),
            body_tpl = VALUES(body_tpl)
    </insert>
</mapper>
