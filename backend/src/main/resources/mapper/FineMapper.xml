<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.FineMapper">

    <resultMap id="fineMap" type="com.library.entity.Fine">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="borrowRecordId" column="borrow_record_id"/>
        <result property="borrowNo" column="borrow_no"/>
        <result property="bookTitle" column="book_title"/>
        <result property="amount" column="amount"/>
        <result property="daysOverdue" column="days_overdue"/>
        <result property="reason" column="reason"/>
        <result property="status" column="status"/>
        <result property="paidTime" column="paid_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectList" resultMap="fineMap">
        SELECT * FROM fines
        <where>
            <if test="!isAdmin">
                user_id = #{userId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectById" resultMap="fineMap">
        SELECT * FROM fines WHERE id = #{id}
    </select>

    <update id="updatePaid">
        UPDATE fines SET paid_time = #{paidTime}, status = #{status} WHERE id = #{id}
    </update>

</mapper>
