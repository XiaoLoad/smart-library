<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.AiConversationMapper">

    <resultMap id="convMap" type="com.library.entity.AiConversation">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="model" column="model"/>
        <result property="status" column="status"/>
        <result property="permissionMode" column="permission_mode"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByUserId" resultMap="convMap">
        SELECT * FROM ai_conversations
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="selectById" resultMap="convMap">
        SELECT * FROM ai_conversations WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.library.entity.AiConversation" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_conversations (user_id, title, model, status, create_time)
        VALUES (#{userId}, #{title}, #{model}, #{status}, #{createTime})
    </insert>

    <update id="updateTitle">
        UPDATE ai_conversations SET title = #{title} WHERE id = #{id}
    </update>

    <update id="updatePermissionMode">
        UPDATE ai_conversations SET permission_mode = #{permissionMode} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ai_conversations WHERE id = #{id}
    </delete>

</mapper>
