/* 封面通道自检 · 页内样式
   页头与状态行与书库页同源，两处各自定义，避免页面样式互相牵连 */
.page-header { margin-bottom: 32rpx; }
.page-title {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.3;
  margin-top: 8rpx;
}
.status-line { text-align: center; padding: 40rpx 0; }

/* 样本信息 */
.path {
  word-break: break-all;
  margin: 8rpx 0;
}
.probe {
  margin-top: 12rpx;
  color: var(--text-2);
}
.act-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 0 16rpx;
}

/* 结论区：四格长得一样，所以这里给一句话收口 */
.verdict-card { border-left: 6rpx solid var(--primary); }
.verdict {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  margin: 12rpx 0 8rpx;
}
.advice { color: var(--text-2); }

/* 通道卡片：大字字母块是「这是哪条通道」的唯一依据，别缩小 */
.chan-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.letter {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--border);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 62rpx;
  text-align: center;
}
.lt-wait { background: var(--bg-subtle); color: var(--text-3); }
.lt-todo { background: var(--bg-subtle); color: var(--text-2); border-color: var(--border-strong); }
.lt-ok {
  background: var(--secondary-light);
  color: var(--secondary);
  border-color: #dde5d6;
}
.lt-fail {
  background: #f2e7e3;
  color: var(--danger);
  border-color: #e5d2cc;
}
.chan-name {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}
.chan-hint {
  margin-top: 6rpx;
  word-break: break-all;
}

.shot { margin-top: 20rpx; }
.shot-img {
  display: block;
  width: 240rpx;
  height: 334rpx;
  border-radius: 4rpx;
  border: 1rpx solid var(--border);
  background-color: var(--bg-subtle);
}
.shot-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  font-size: 22rpx;
}

.judge {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
