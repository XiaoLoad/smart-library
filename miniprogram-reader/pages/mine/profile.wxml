<view class="page" wx:if="{{user}}">
  <view class="page-header">
    <text class="eyebrow">PROFILE</text>
    <view class="page-title serif">个人档案</view>
  </view>

  <view class="card">
    <text class="eyebrow">BASIC</text>
    <view class="section-title serif">基本信息</view>
    <view class="kv"><text class="k">姓名</text><text>{{user.realName}}</text></view>
    <view class="kv"><text class="k">账号</text><text>{{user.username}}</text></view>
    <view class="kv"><text class="k">身份</text><text>{{user.roleName}}</text></view>
    <view class="kv" wx:if="{{user.studentNo}}"><text class="k">学号</text><text>{{user.studentNo}}</text></view>
    <view class="kv" wx:if="{{user.teacherNo}}"><text class="k">工号</text><text>{{user.teacherNo}}</text></view>
    <view class="kv" wx:if="{{user.department}}"><text class="k">院系</text><text>{{user.department}}</text></view>
    <view class="kv" wx:if="{{user.className}}"><text class="k">班级</text><text>{{user.className}}</text></view>
    <view class="kv" wx:if="{{user.major}}"><text class="k">专业</text><text>{{user.major}}</text></view>
  </view>

  <view class="card">
    <text class="eyebrow">CONTACT</text>
    <view class="section-title serif">联系方式</view>
    <view class="field">
      <view class="field-label">邮箱</view>
      <input class="field-input" value="{{form.email}}" data-field="email" bindinput="onInput" placeholder="请输入邮箱" placeholder-class="ph" />
    </view>
    <view class="field">
      <view class="field-label">手机号</view>
      <input class="field-input" value="{{form.phone}}" data-field="phone" bindinput="onInput" placeholder="请输入手机号" placeholder-class="ph" type="number" maxlength="11" />
    </view>
    <button class="btn btn-primary btn-block" loading="{{saving}}" bindtap="onSave">保存</button>
    <view class="tiny" style="margin-top:20rpx;">姓名与身份信息如需变更请联系管理员</view>
  </view>
</view>
<view wx:elif="{{loading}}" class="tiny" style="text-align:center;padding:80rpx;">加载中…</view>
