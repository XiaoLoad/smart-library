.page-header { margin-bottom: 32rpx; }
.page-title { font-size: 56rpx; font-weight: 600; letter-spacing: 4rpx; margin-top: 8rpx; }

.stat-line { display: flex; align-items: baseline; gap: 16rpx; margin-top: 8rpx; }
.stat-value { font-size: 88rpx; font-weight: 600; line-height: 1.1; }
.stat-unit { font-size: 26rpx; color: var(--text-3); }

/* —— 细线三栏 —— */
.stat-grid { display: flex; }
.stat-cell {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  border-right: 1rpx solid var(--bg-muted);
}
.stat-cell:last-child { border-right: none; }
.grid-num { font-size: 48rpx; font-weight: 600; }
.danger { color: var(--danger); }

.tip-row { display: flex; gap: 16rpx; padding: 10rpx 0; }
.tip-no { color: var(--text-3); font-size: 28rpx; }
