<view class="page">
  <view class="page-header">
    <text class="eyebrow">SECURITY</text>
    <view class="page-title serif">修改密码</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-label">当前密码</view>
      <input class="field-input" password value="{{oldPassword}}" data-field="oldPassword" bindinput="onInput" placeholder="请输入当前密码" placeholder-class="ph" />
    </view>
    <view class="field">
      <view class="field-label">新密码</view>
      <input class="field-input" password value="{{newPassword}}" data-field="newPassword" bindinput="onInput" placeholder="至少 6 位" placeholder-class="ph" />
    </view>
    <view class="field">
      <view class="field-label">确认新密码</view>
      <input class="field-input" password value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onInput" placeholder="再次输入新密码" placeholder-class="ph" confirm-type="done" bindconfirm="onSubmit" />
    </view>
    <button class="btn btn-primary btn-block" loading="{{saving}}" bindtap="onSubmit">确认修改</button>
  </view>
</view>
