/* —— 页头 —— */
.page-header { margin-bottom: 32rpx; }
.page-title { font-size: 56rpx; font-weight: 600; letter-spacing: 4rpx; margin-top: 8rpx; }

/* —— 额度 · 纸面数字 —— */
.quota-line { display: flex; align-items: baseline; gap: 16rpx; margin-top: 6rpx; }
.quota-num { font-size: 72rpx; font-weight: 600; line-height: 1.1; }
.quota-unit { font-size: 26rpx; color: var(--text-3); }
.warn { color: var(--danger); }

/* —— 状态坞 · 滑过额度卡后吸附在视口顶部 ——
   与书库页的检索坞同构：负外边距拉成通栏（本页左右内边距是 28rpx）、背景填页面同色，
   列表从它底下滚过去时靠背景盖住。 */
.dock {
  position: sticky;
  top: 0;
  z-index: 60;
  margin: 0 -28rpx 28rpx;
  padding: 12rpx 28rpx 0;
  background: var(--bg);
}
/* 吸附中只补一道极浅投影——发丝线由 .segments 自带的下划线充当 */
.dock.stuck { box-shadow: 0 12rpx 18rpx -16rpx rgba(44, 40, 37, 0.3); }

/* —— 分段 · 下划线 —— */
.segments {
  white-space: nowrap;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 0; /* 与下方记录卡的间距交给 .dock */
}
.seg {
  display: inline-block;
  padding: 14rpx 26rpx 18rpx;
  font-size: 27rpx;
  color: var(--text-2);
  position: relative;
}
.seg-active { color: var(--primary); font-weight: 600; }
.seg-active::after {
  content: '';
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  bottom: 0;
  height: 3rpx;
  background: var(--primary);
}

/* —— 分段的六屏 ——
   swiper 不自带滚动：高度由 JS 量当前屏内容的真实高度设给它（内联 style 覆盖下面
   的兜底值），内容多高 swiper 就多高，超出屏幕的部分由页面往下滚。height 过渡让
   切段/翻页时的高度变化与滑动的 260ms 同节奏。兜底值只在量到前顶一两帧。 */
.panes {
  width: 100%;
  height: calc(100vh - 620rpx - env(safe-area-inset-bottom));
  transition: height 260ms ease-out;
}

/* —— 借阅记录 —— */
.rec-title { font-size: 32rpx; font-weight: 600; }
.no-line { letter-spacing: 1rpx; margin: 6rpx 0; }
.record .tiny { margin-top: 4rpx; }
.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--bg-muted);
  justify-content: flex-end;
}
