.qr-page { padding-top: 24rpx; }
.qr-card { text-align: center; padding: 44rpx 28rpx; }
.qr-title { font-size: 40rpx; font-weight: 600; letter-spacing: 4rpx; margin: 8rpx 0 32rpx; }
.qr-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border-strong);
  border-radius: 4rpx;
  padding: 16rpx;
  margin: 0 auto 28rpx;
  width: 512rpx;
  height: 512rpx;
  box-sizing: border-box;
}
.qr-canvas { width: 480rpx; height: 480rpx; }
.qr-fallback { padding: 24rpx; word-break: break-all; font-size: 24rpx; color: var(--text-2); }
.qr-no { font-size: 38rpx; font-weight: 600; letter-spacing: 4rpx; margin-bottom: 8rpx; }

/* —— 说明 · 汉字序号 ——
   序号 28rpx 继承页面的行高 1.8（=25.2px），正文 24rpx 带 1.7（=20.4px），
   两者半行距不等，而 flex 的 stretch 只对齐盒顶，序号被压低。
   375px 视口实测：序号字形盒比正文低 2.00px。
   把行高统一到 40rpx（正文本来的行距节奏）后字号差不再影响半行距，字形盒重合为 0。
   不用 align-items: baseline：实测基线虽能对齐，汉字墨迹中心仍差 1.5~2.5px；
   字形盒对齐式只剩 0.5~1.5px（残余来自一二三四 自己在字身框内的位置，改不掉）。 */
.tip-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 10rpx 0;
  line-height: 40rpx;
}
/* .tiny 自带 line-height: 1.7，会盖掉继承值，故在行内显式盖回来 */
.tip-row .tiny { line-height: 40rpx; }
.tip-no {
  flex-shrink: 0;
  color: var(--text-3);
  font-size: 28rpx;
}
