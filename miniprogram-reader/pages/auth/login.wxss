.login-page { min-height: 100vh; padding: 110rpx 56rpx 48rpx; box-sizing: border-box; }

/* —— 刊头 —— */
.masthead { text-align: center; margin-bottom: 72rpx; }
.seal {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 28rpx;
  background: var(--danger);
  color: var(--inverse);
  font-size: 46rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 4rpx;
}
.wordmark { font-size: 64rpx; font-weight: 600; letter-spacing: 6rpx; margin-bottom: 14rpx; }

/* —— 表单卡 —— */
.form-card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  padding: 44rpx 36rpx;
}
.remember-row { margin-bottom: 32rpx; }
.remember { gap: 14rpx; }
.check-box {
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid var(--border-strong);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check-box.checked { background: var(--primary); border-color: var(--primary); }
.login-btn { letter-spacing: 8rpx; }
.ph { color: var(--text-3); }
.tip { text-align: center; margin-top: 24rpx; letter-spacing: 1rpx; }
