<view class="login-page">
  <!-- 水印「書」：扉页母题，出血裁切 -->
  <view class="mark serif">書</view>

  <view class="content">
    <!-- 扉页刊头：朱印 + 拉丁眉标 + 宋体大标题 -->
    <view class="masthead rise">
      <view class="mast-row">
        <view class="seal serif">書</view>
        <view class="eyebrow">SMART LIBRARY · READER</view>
      </view>
      <view class="headline serif">
        <text class="hl-line">于书海之间，</text>
        <text class="hl-line">寻得一席静处。</text>
      </view>
    </view>

    <!-- 细线 + 元信息行 -->
    <view class="rule rise d1"></view>
    <view class="meta-row rise d1">
      <text class="meta">登录 SIGN IN</text>
      <text class="meta">No. 01</text>
    </view>

    <!-- 编号下划线式表单 -->
    <view class="field rise d2">
      <view class="field-label">01 · 账号</view>
      <input class="field-input" value="{{username}}" placeholder="请输入账号" placeholder-class="ph" bindinput="onUsername" />
    </view>
    <view class="field rise d2">
      <view class="field-label">02 · 密码</view>
      <input
        class="field-input"
        password
        value="{{password}}"
        placeholder="请输入密码"
        placeholder-class="ph"
        bindinput="onPassword"
        confirm-type="done"
        bindconfirm="onLogin"
      />
    </view>

    <view class="row-between remember-row rise d3">
      <view class="row remember" bindtap="toggleRemember">
        <view class="check-box {{remember ? 'checked' : ''}}">
          <app-icon wx:if="{{remember}}" name="check" size="20" color="#faf8f5" />
        </view>
        <text class="tiny">记住账号</text>
      </view>
    </view>

    <button class="btn btn-primary btn-block login-btn rise d3" loading="{{loading}}" bindtap="onLogin">登 录</button>

    <view class="or-row rise d4"><view class="or-line"></view><text class="or-txt">或</text><view class="or-line"></view></view>

    <button class="btn-wx rise d4" bindtap="onWechatLogin">
      <app-icon name="wechat" size="30" color="#6b6560" />
      <text>微信一键登录</text>
    </button>
    <view class="tiny tip rise d4">首次请用账号密码登录，成功后可绑定微信实现一键登录</view>

    <!-- 落款：与 AI 空态同一 EX LIBRIS 母题 -->
    <view class="foot-row rise d4">
      <text class="foot-star serif">✦</text>
      <text class="foot-txt serif">EX LIBRIS · 馆藏之外，皆为序章</text>
    </view>
  </view>
</view>
