<view class="login-page">
  <!-- Editorial 刊头：朱印 + 宋体字标 + 字距展开的拉丁小字 -->
  <view class="masthead">
    <view class="seal serif">書</view>
    <view class="wordmark serif">智慧图书馆</view>
    <view class="eyebrow">SMART LIBRARY · READER</view>
  </view>

  <view class="form-card">
    <view class="field">
      <view class="field-label">账号</view>
      <input class="field-input" value="{{username}}" placeholder="请输入账号" placeholder-class="ph" bindinput="onUsername" />
    </view>
    <view class="field">
      <view class="field-label">密码</view>
      <input
        class="field-input"
        password
        value="{{password}}"
        placeholder="请输入密码"
        placeholder-class="ph"
        bindinput="onPassword"
        confirm-type="done"
        bindconfirm="onLogin"
      />
    </view>
    <view class="row-between remember-row">
      <view class="row remember" bindtap="toggleRemember">
        <view class="check-box {{remember ? 'checked' : ''}}">
          <app-icon wx:if="{{remember}}" name="check" size="20" color="#faf8f5" />
        </view>
        <text class="tiny">记住账号</text>
      </view>
    </view>

    <button class="btn btn-primary btn-block login-btn" loading="{{loading}}" bindtap="onLogin">登 录</button>

    <view class="hr"></view>
    <button class="btn btn-outline btn-block" bindtap="onWechatLogin">
      <app-icon name="wechat" size="30" color="#6b6560" />
      微信一键登录
    </button>
    <view class="tiny tip">首次使用请用账号密码登录，成功后可绑定微信实现一键登录</view>
  </view>
</view>
