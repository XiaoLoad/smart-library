<view class="page">
  <view class="page-header">
    <text class="eyebrow">INBOX</text>
    <view class="page-title serif">消息</view>
  </view>

  <!-- 分段坞：滑过页头后吸附在视口顶部 -->
  <view class="dock {{dockStuck ? 'stuck' : ''}}">
    <view class="tabs">
      <view
        wx:for="{{segments}}"
        wx:key="key"
        class="tab {{current === index ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSegment"
      >{{item.label}}<text wx:if="{{item.key === 'notice' && unread > 0}}" class="unread-count">{{unread}}</text></view>
    </view>
  </view>

  <!-- 一个分段一屏：swiper 只管左右滑切段。高度由 JS 按当前屏内容的真实高度设定
       （不低于坞以下的可视区），列表不自带滚动——纵向滑动、下拉刷新、触底翻页
       全部是页面级手势。 -->
  <swiper
    class="panes"
    style="{{swiperH ? 'height:' + swiperH + 'px' : ''}}"
    current="{{current}}"
    duration="260"
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{panes}}" wx:for-item="pane" wx:for-index="pi" wx:key="key">
      <view class="pane">
        <!-- 通知 -->
        <block wx:if="{{pane.key === 'notice'}}">
          <skeleton wx:if="{{pane.firstLoad || (pane.loading && !pane.list.length)}}" variant="notice" count="4" />
          <view class="row-between readall-bar" wx:if="{{pane.list.length}}">
            <text class="tiny">共 {{pane.list.length}} 条</text>
            <text class="link" bindtap="onReadAll">全部标记已读</text>
          </view>
          <view
            class="card notice {{item.isRead ? '' : 'notice-unread'}}"
            wx:for="{{pane.list}}"
            wx:key="id"
            data-index="{{index}}"
            bindtap="onNoticeTap"
          >
            <view class="row-between">
              <view class="row notice-head">
                <view class="badge {{item.type === 2 ? 'badge-red' : item.type === 3 ? 'badge-orange' : item.type === 4 ? 'badge-blue' : 'badge-gray'}}">{{item.typeText}}</view>
                <text class="notice-title ellipsis">{{item.title}}</text>
                <text wx:if="{{!item.isRead}}" class="dot"></text>
              </view>
            </view>
            <view class="muted notice-content">{{item.content}}</view>
            <view class="tiny">{{item.timeText}}</view>
          </view>
          <empty-state wx:if="{{!pane.firstLoad && !pane.loading && !pane.list.length}}" text="暂无通知" icon="bell" />
        </block>

        <!-- 公告 -->
        <block wx:else>
          <skeleton wx:if="{{pane.firstLoad || (pane.loading && !pane.list.length)}}" variant="announce" count="4" />
          <view
            class="card announce fade-in"
            wx:for="{{pane.list}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="goAnnounce"
          >
            <view class="row-between">
              <view class="flex-1 ellipsis announce-title serif">
                <text wx:if="{{item.top}}" class="badge badge-red badge-inline">置顶</text>
                {{item.title}}
              </view>
              <app-icon name="chevron-right" size="26" color="#9c958d" />
            </view>
            <view class="tiny">{{item.publisherName}} · {{item.timeText}}</view>
          </view>
          <empty-state wx:if="{{!pane.firstLoad && !pane.loading && !pane.list.length}}" text="暂无公告" icon="scroll" />
          <view wx:if="{{pane.loading && pane.list.length}}" class="tiny" style="text-align:center;padding:24rpx;">加载中…</view>
          <view wx:if="{{pane.finished && pane.list.length}}" class="tiny eyebrow" style="text-align:center;padding:24rpx;">— END —</view>
        </block>
      </view>
    </swiper-item>
  </swiper>
</view>