/* —— 页头 —— */
.page-header { margin-bottom: 28rpx; }
.page-title { font-size: 56rpx; font-weight: 600; letter-spacing: 4rpx; margin-top: 8rpx; }

/* —— 分段 · 下划线 —— */
.tabs {
  display: flex;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0 18rpx;
  font-size: 27rpx;
  color: var(--text-2);
  position: relative;
}
.tab-active { color: var(--primary); font-weight: 600; }
.tab-active::after {
  content: '';
  position: absolute;
  left: 30%;
  right: 30%;
  bottom: 0;
  height: 3rpx;
  background: var(--primary);
}
.unread-count {
  display: inline-block;
  color: var(--danger);
  font-size: 22rpx;
  margin-left: 8rpx;
  vertical-align: super;
}

.readall-bar { margin-bottom: 16rpx; padding: 0 4rpx; }
.link { color: var(--primary); font-size: 26rpx; }

/* —— 通知条目 —— */
.notice { padding: 26rpx 28rpx; }
.notice-unread { border-left: 3rpx solid var(--primary); }
.notice-head { gap: 16rpx; flex: 1; min-width: 0; }
.notice-title { font-size: 29rpx; font-weight: 600; flex: 1; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--danger); flex-shrink: 0; }
.notice-content { margin: 10rpx 0; font-size: 26rpx; }

/* —— 公告条目 —— */
.announce-title { font-size: 31rpx; font-weight: 600; }
.badge-inline { margin-right: 14rpx; }
