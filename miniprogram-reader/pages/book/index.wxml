<!-- 抽屉打开时锁住页面根节点（相当于 H5 的 body { overflow: hidden }）。
     滚动穿透只能在根节点这一层根治：树内容不满一屏、或树已滑到尽头时，
     手势在 scroll-view 里无处可去，只能顺着滚动链交给页面——锁住根节点后，
     页面这一层根本没有可滚动的余地，手势就只剩「落在树自己身上」这一种去向。
     不要退回去用 catchtouchmove 拦：挂在 .cat-sheet 这类 scroll-view 的祖先上，
     会连树的手势一起截获（滑一段就停，这是上一版的真实故障）。 -->
<page-meta page-style="{{catOpen ? 'overflow:hidden' : ''}}" />

<view class="page">
  <!-- Editorial 页头 -->
  <view class="page-header">
    <text class="eyebrow">COLLECTION</text>
    <view class="page-title serif">馆藏图书</view>
    <view class="tiny" wx:if="{{countText}}">{{countText}}</view>
  </view>

  <!-- 检索坞：滑过页头后吸附在视口顶部，成一条通栏工具条——滑到第几屏都能直接搜索、
       改分类。未吸附时不加任何多余线条，静态观感与改动前一致。 -->
  <view class="dock {{dockStuck ? 'stuck' : ''}}">
    <view class="searchbar">
      <app-icon name="search" size="28" color="#9c958d" />
      <input
        class="search-input"
        placeholder="搜索书名 / 作者 / ISBN"
        placeholder-class="ph"
        value="{{keyword}}"
        bindinput="onKeyword"
        confirm-type="search"
      />
      <view wx:if="{{keyword}}" class="search-clear" catchtap="onClearKeyword">
        <app-icon name="close" size="26" color="#9c958d" />
      </view>
      <view class="filter-btn" catchtap="openCat">
        <view class="filter-label ellipsis">{{catSelName || '分类'}}</view>
        <app-icon name="chevron-down" size="22" color="#3a5a6b" />
      </view>
    </view>
  </view>

  <!-- 书架还没摆上书（首屏、或换了筛选条件）时先立一块骨架，与真实三列版式同构 -->
  <skeleton wx:if="{{loading && !list.length}}" variant="shelf" count="4" />

  <!-- 书目 · 三列封面立在架线上，架签在台板下方。
       入场在「这一批数据到货」时触发：排之间按 row.delay 错峰，同一排内三本再按 book.d
       错峰，书架像被逐本陈列出来。翻页时新排一到就入场，正好是用户滑到底的那一刻。 -->
  <view class="shelf-row" wx:for="{{rows}}" wx:for-item="row" wx:key="key">
    <view class="grid">
      <view
        class="shelf-cell"
        style="animation-delay:{{row.delay + book.d}}ms"
        wx:for="{{row.items}}"
        wx:for-item="book"
        wx:key="id"
        data-id="{{book.id}}"
        bindtap="goDetail"
        hover-class="shelf-cell-hover"
        hover-stay-time="80"
      >
        <view class="cover">
          <view class="cover-inner">
            <view class="cover-inner-title serif">{{book.displayTitle}}</view>
            <view class="cover-seal"></view>
          </view>
          <view wx:if="{{book.cover}}" class="cover-img" style="background-image:url('{{book.cover}}');background-size:cover;background-position:center"></view>
        </view>
        <view class="book-title ellipsis">{{book.displayTitle}}</view>
        <view class="book-loc ellipsis">{{book.location || '—'}}</view>
        <view class="book-state {{book.stateClass}}">{{book.stateText}}</view>
      </view>
    </view>
    <view class="shelf-line" style="animation-delay:{{row.delay + 150}}ms"></view>
    <view class="shelf-edge" style="animation-delay:{{row.delay + 150}}ms"></view>
  </view>

  <empty-state wx:if="{{!firstLoad && !loading && !list.length}}" text="没有找到相关图书" icon="search" />
  <!-- 翻页时的等待：架上有书才在底部提示，空屏那一路交给上面的骨架 -->
  <view wx:if="{{loading && list.length}}" class="tiny status-line">加载中…</view>
  <view wx:if="{{finished && list.length}}" class="tiny status-line eyebrow">— END OF COLLECTION —</view>
</view>

<!-- 分类树抽屉：父节点即筛选，箭头单独负责展开收起 -->
<view class="cat-mask {{catOpen ? 'show' : ''}}" catchtap="closeCat" catchtouchmove="noop" />
<!-- 抽屉内一律不挂 catchtouchmove：scroll-view 的手势不能被 JS 层截获。
     「底层不跟着滚」由上面的 page-meta 负责。 -->
<view class="cat-sheet {{catOpen ? 'show' : ''}} {{catDragging ? 'dragging' : ''}}" style="height:{{catHeight}}vh">
  <view class="cat-grip" catchtouchstart="onCatGripStart" catchtouchmove="onCatGripMove" catchtouchend="onCatGripEnd" catchtouchcancel="onCatGripEnd"><view class="cat-grip-bar"></view></view>
  <view class="cat-head">
    <view class="cat-title serif">分类</view>
    <view class="cat-reset" catchtap="onCatReset">全部图书</view>
  </view>
  <view class="cat-divider"></view>
  <scroll-view class="cat-tree" scroll-y>
    <view
      class="node {{node.count ? '' : 'is-off'}} {{catSelId === node.id ? 'is-on' : ''}}"
      wx:for="{{catNodes}}"
      wx:for-item="node"
      wx:key="id"
      style="padding-left:{{node.pad}}rpx"
      data-id="{{node.id}}"
      bindtap="onCatSelect"
      hover-class="node-hover"
      hover-stay-time="60"
    >
      <view wx:if="{{catSelId === node.id}}" class="node-bar"></view>
      <view wx:if="{{node.lv >= 2}}" class="node-guide" style="left:52rpx"></view>
      <view wx:if="{{node.lv >= 3}}" class="node-guide" style="left:88rpx"></view>
      <view wx:if="{{node.hasChildren}}" class="node-chevron">
        <app-icon name="{{node.open ? 'chevron-down' : 'chevron-right'}}" size="28" color="#9c958d" />
        <!-- 箭头的透明命中层：视觉上箭头仍只占 32rpx，但可点范围向左扩到 88rpx、上下撑满整行 84rpx。
             向左扩是刻意的——那一带是缩进留白（只有装饰性的树线），把它让给「展开」，
             才不会误触到右侧书名的「筛选并关闭」。 -->
        <view class="chevron-hit" catchtap="onCatToggle" data-id="{{node.id}}"></view>
      </view>
      <view wx:else class="node-chevron"></view>
      <view class="node-name ellipsis">{{node.name}}</view>
      <view class="node-count">{{node.count}}</view>
    </view>
    <view class="cat-tail"></view>
  </scroll-view>
</view>
