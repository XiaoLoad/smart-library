<view wx:if="{{book}}" class="page detail-page">
  <!-- 藏书票 · 书影、定价与库存刻 -->
  <view class="plate fade-in">
    <view class="plate-main">
      <view class="big-cover">
        <image wx:if="{{cover}}" class="cover-img" src="{{cover}}" mode="aspectFill" />
        <view wx:else class="cover-blank">
          <view class="spine"></view>
          <text class="cover-char serif">{{coverChar}}</text>
        </view>
      </view>
      <view class="flex-1">
        <text class="eyebrow">BOOK</text>
        <view class="title serif">{{book.title}}</view>
        <view class="muted author">{{book.author}}</view>
        <view class="tiny">{{book.publisher || '—'}}</view>
        <view class="row meta">
          <view class="badge {{book.availableCount > 0 ? 'badge-green' : 'badge-red'}}">
            {{book.availableCount > 0 ? '可借' : '已借完'}}
          </view>
        </view>
      </view>
    </view>

    <view class="plate-strip">
      <view class="price">
        <text class="price-cny serif">¥</text>
        <text class="price-num serif">{{priceNum}}</text>
        <text class="price-unit">定价</text>
      </view>
      <text class="stock-text">可借 {{book.availableCount}} · 馆藏 {{book.totalCount}}</text>
    </view>
    <view class="ticks">
      <view wx:for="{{stockTicks}}" wx:key="i" class="tick {{item.on ? 'on' : ''}}"></view>
    </view>
  </view>

  <view class="card">
    <text class="eyebrow">DETAILS</text>
    <view class="section-title serif">图书信息</view>
    <view class="kv">
      <text class="k">ISBN</text>
      <view class="ldr"></view>
      <text class="v mono">{{book.isbn || '—'}}</text>
    </view>
    <view class="kv">
      <text class="k">位置</text>
      <view class="ldr"></view>
      <text class="v mono">{{book.location || '—'}}</text>
    </view>
    <view class="kv">
      <text class="k">出版</text>
      <view class="ldr"></view>
      <text class="v">{{pubDateText}}</text>
    </view>
    <view class="kv">
      <text class="k">状态</text>
      <view class="ldr"></view>
      <text class="v">{{book.status === 1 ? '在架' : '下架'}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{book.description}}">
    <text class="eyebrow">SYNOPSIS</text>
    <view class="section-title serif">内容简介</view>
    <view class="desc">
      <text wx:if="{{descHead}}" class="dropcap serif">{{descHead}}</text>
      <text user-select>{{descRest}}</text>
    </view>
  </view>

  <view class="footer-bar">
    <view wx:if="{{blockReason}}" class="block-reason tiny">{{blockReason}}</view>
    <button
      class="btn btn-primary btn-block action"
      disabled="{{!canBorrow || borrowing}}"
      loading="{{borrowing}}"
      bindtap="onBorrow"
    >
      {{borrowing ? '提交中…' : (canBorrow ? '立即借阅' : '暂不可借')}}
    </button>
  </view>
</view>
<view wx:elif="{{loading}}" class="tiny" style="text-align:center;padding:80rpx;">加载中…</view>