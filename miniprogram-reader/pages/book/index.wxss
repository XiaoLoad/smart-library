/* —— 页面容器 · 三列网格比默认多留两侧余量 —— */
.page { padding: 32rpx 36rpx calc(var(--tabbar-h) + env(safe-area-inset-bottom)); }

/* —— 页头 · Editorial（保留完整三行，不做压缩） —— */
.page-header { margin-bottom: 20rpx; } /* 20 + .dock 的 12rpx 顶部内边距 = 原来的 32rpx */
.page-title {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.3;
  margin-top: 8rpx;
}

/* —— 检索坞 · 滑过页头后吸附在视口顶部 ——
   负外边距把坞拉成通栏（页面左右各 36rpx 的内边距由坞自己补回来），背景填页面同色，
   吸附时滑上来的书架从它底下穿过，不会从文字旁边露出来。
   坞的内边距是把原有间距折进来的：顶部 12rpx 由 .page-header 的 margin 32→20 补足，
   底部 20+16 仍是原来 .searchbar 的 36rpx，所以不吸附时的观感与改动前完全一致。 */
.dock {
  position: sticky;
  top: 0;
  z-index: 60; /* 高于书架、低于分类遮罩(90) */
  margin: 0 -36rpx 16rpx;
  padding: 12rpx 36rpx 20rpx;
  background: var(--bg);
}
/* 吸附中：补一条发丝线 + 一道极浅投影，做出「贴上去」的层次。
   走 box-shadow 而不是 border——切进切出时高度不变，不会把下方书架推一下。 */
.dock.stuck { box-shadow: 0 1rpx 0 var(--border), 0 12rpx 18rpx -16rpx rgba(44, 40, 37, 0.3); }

/* —— 检索条 · 分类按钮内嵌在右端 —— */
.searchbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 6rpx;
  margin-bottom: 0; /* 与下方书架的间距交给 .dock 的内外边距 */
}
.search-input { flex: 1; min-width: 0; height: 100%; font-size: 26rpx; }
.ph { color: var(--text-3); }
.search-clear { flex-shrink: 0; padding: 8rpx 4rpx; }
.filter-btn {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex-shrink: 0;
  max-width: 260rpx;
  height: 44rpx;
  padding-left: 22rpx;
  border-left: 1rpx solid var(--border);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 500;
}
.filter-label { max-width: 190rpx; }

/* —— 入场 · 首屏「页头 → 检索条 → 书目」依次落位 ——
   只用 opacity/transform（合成层动画），不动布局属性，滚动与首屏渲染都不掉帧。
   缓动统一走 cubic-bezier(0.16, 1, 0.3, 1)：起手快、收尾极缓，落位时是「停下」而不是「刹住」。 */
@keyframes bk-rise {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
/* 架线由左端推导而出，与封面同批落位，像书架被一格格搭起来 */
@keyframes bk-draw {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}
.page-header { animation: bk-rise 0.52s cubic-bezier(0.16, 1, 0.3, 1) both; }
.searchbar { animation: bk-rise 0.52s cubic-bezier(0.16, 1, 0.3, 1) 70ms both; }

/* —— 书目 · 每排三本立在一条架线上，书名/位置/状态作架签挂在台板下 —— */
.shelf-row { position: relative; margin-top: 36rpx; }
.shelf-row + .shelf-row { margin-top: 44rpx; }
.grid { display: flex; flex-wrap: wrap; column-gap: 30rpx; }
/* 栏宽 = (678 - 60) / 3 = 206rpx；封面高 287rpx 恰为 206 ÷ 0.7177（中图法封面原比例）
   类名不要用 .cell —— app.wxss 里的 .cell 是「单元格列表」样式（flex 横排 + 下边框），
   重名会把整格掰成横排、封面被挤没。改名前先跟 app.wxss 的全局类过一遍。 */
.shelf-cell { width: calc((100% - 60rpx) / 3); box-sizing: border-box; }
.shelf-cell-hover { opacity: 0.65; }

/* —— 进场 · 每批书目到货时逐排错峰升起（错峰量由 index.js 算好写在行内 animation-delay）——
   只让动画守着「入场」这一件事，任何一排都不会被长期隐藏——之前用相交观察器把屏外的排
   藏起来等它进视口，回调一旦没到，排就在眼前空着，这是内容页不能接受的。
   填充模式用 backwards 而非 both：等待期沿用起始帧（错峰时格子是隐着的），动画结束后样式
   交还给普通声明，.shelf-cell-hover 的按下变淡才不会被动画的 forwards 终态压住。 */
.shelf-cell { animation: bk-rise 0.56s cubic-bezier(0.16, 1, 0.3, 1) backwards; }
/* 架线比同排的书晚 150ms（延时写在行内），由左端推导而出，像书架被一格格搭起来 */
.shelf-line,
.shelf-edge {
  animation: bk-draw 0.5s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  transform-origin: left center;
}

.cover {
  position: relative;
  height: 287rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  background: var(--bg-subtle);
  overflow: hidden;
}
/* 无封面时的「内封」兜底，被上层真实封面盖住，封面缺图或加载失败才露出来 */
.cover-inner {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 18rpx 14rpx;
  border: 1rpx solid var(--border-strong);
  background: var(--bg-subtle);
}
.cover-inner-title { font-size: 24rpx; line-height: 1.4; color: var(--text); }
.cover-seal { align-self: flex-end; width: 22rpx; height: 22rpx; background: var(--danger); }
.cover-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }

.shelf-line { position: absolute; left: 0; right: 0; top: 287rpx; height: 1rpx; background: var(--border-strong); }
.shelf-edge { position: absolute; left: 0; right: 0; top: 288rpx; height: 8rpx; background: var(--bg-muted); }

.book-title { font-size: 24rpx; font-weight: 500; line-height: 1.5; margin-top: 20rpx; color: var(--text); }
.book-loc { font-size: 22rpx; line-height: 1.5; color: var(--text-3); }
.book-state { font-size: 22rpx; line-height: 1.5; }
.st-ok { color: var(--success); }
.st-warn { color: var(--warning); }
.st-danger { color: var(--danger); }
.st-gray { color: var(--text-3); }

.status-line { text-align: center; padding: 48rpx 0; }

/* —— 分类树抽屉 —— */
.cat-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  background: rgba(44, 40, 37, 0.38);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.24s;
}
.cat-mask.show { opacity: 1; visibility: visible; }

.cat-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  height: 72vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-elevated);
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  visibility: hidden;
  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), height 0.28s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.28s;
}
.cat-sheet.show { transform: translateY(0); visibility: visible; }
/* 拖动中关掉过渡，让面板贴手跟指；松手恢复，落点就近吸附 */
.cat-sheet.dragging { transition: none; }

.cat-grip { display: flex; align-items: center; justify-content: center; height: 40rpx; }
.cat-grip-bar { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--border-strong); }
.cat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  padding: 0 36rpx;
}
.cat-title { font-size: 32rpx; font-weight: 600; }
.cat-reset { font-size: 26rpx; font-weight: 500; color: var(--primary); }
.cat-divider { height: 1rpx; background: var(--border); }
/* 树侧兜底：即便某个渲染层仍把滚动链外溢一层，到这里也截断。
   （根治靠 index.wxml 里的 page-meta，不是靠这一条。） */
.cat-tree { flex: 1; min-height: 0; overscroll-behavior: contain; }
/* 树尾留白 = 底部导航栏高度 + 安全区 + 40rpx 呼吸量。
   自定义 tabBar 由框架渲染在页面容器层级（见 custom-tab-bar/index.wxss），抽屉的 z-index
   再高也盖不住它，所以抽屉最下面这一截永远被导航栏压着。把这截高度补在内容末尾，
   滑到底时最后一个分类正好停在导航栏上沿；不补的话「其实已经滑到底、只是被挡住」，
   手感上就是滑不动。 */
.cat-tail { height: calc(var(--tabbar-h) + env(safe-area-inset-bottom) + 40rpx); }

.node {
  position: relative;
  display: flex;
  align-items: center;
  height: 84rpx;
  padding-right: 36rpx;
}
.node-hover { background: var(--bg-subtle); }
.node-guide { position: absolute; top: 0; bottom: 0; width: 1rpx; background: var(--border); }
.node-chevron {
  position: relative; /* chevron-hit 以此为定位基准 */
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}
/* 箭头的可点区域：绝对定位的透明覆盖层，不参与布局，所以树的视觉缩进一点没变。
   宽 88rpx（44px）满足触控最小命中尺寸；height 84rpx 正好等于 .node 的整行高，
   上下不会溢到相邻行去抢点击。 */
.chevron-hit {
  position: absolute;
  top: 50%;
  right: 0;
  width: 88rpx;
  height: 84rpx;
  transform: translateY(-50%);
}
.node-name { flex: 1; min-width: 0; font-size: 26rpx; color: var(--text); }
.node-count { flex-shrink: 0; margin-left: 16rpx; font-size: 22rpx; color: var(--text-3); }
.node.is-off .node-name,
.node.is-off .node-count { color: var(--text-3); }
.node.is-on { background: var(--primary-light); }
.node.is-on .node-name { color: var(--primary); font-weight: 500; }
.node.is-on .node-count { color: var(--primary); }
.node-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 6rpx; background: var(--primary); }
