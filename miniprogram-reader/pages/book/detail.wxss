.detail-page { padding-bottom: 220rpx; }

/* —— 书影区 · 非对称双栏 —— */
.book-head {
  display: flex;
  gap: 32rpx;
  padding-bottom: 32rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border);
}
.big-cover {
  width: 192rpx;
  height: 264rpx;
  border-radius: 4rpx;
  background: var(--bg-subtle);
  flex-shrink: 0;
}
.cover-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
}
.title { font-size: 46rpx; font-weight: 600; line-height: 1.35; margin: 6rpx 0; }
.author { margin-bottom: 4rpx; }
.meta { gap: 16rpx; margin-top: 20rpx; }

/* —— 信息行 · 细线分隔 —— */
.kv {
  display: flex;
  padding: 14rpx 0;
  font-size: 27rpx;
  border-bottom: 1rpx solid var(--bg-muted);
}
.kv:last-child { border-bottom: none; }
.kv .k { width: 140rpx; color: var(--text-3); flex-shrink: 0; letter-spacing: 2rpx; }
.desc { font-size: 27rpx; color: var(--text-2); line-height: 1.9; }

/* —— 底部操作条 —— */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-elevated);
  border-top: 1rpx solid var(--border);
}
.action { letter-spacing: 6rpx; }
.block-reason { color: var(--warning); text-align: center; margin-bottom: 12rpx; line-height: 1.5; }
