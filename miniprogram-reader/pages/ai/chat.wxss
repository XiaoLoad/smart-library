/* 方案 A · 编辑栏手稿：固定顶栏 + 固定底部书写条，消息区正好落在 tabBar 上方 */
.chat-page {
  display: flex;
  flex-direction: column;
  /* 底部导航是贴地实栏（高 --tabbar-h），100vh 内减去它 + 安全区，输入条正好落在栏上方，
     不再需要为「破出的光球」额外预留补偿量 */
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
  background: var(--bg);
  /* 关键：锁死页面自身不滚动，溢出全部交给中间 scroll-view；否则长消息会把输入条顶出视口 */
  overflow: hidden;
}

/* —— 顶栏 · 细线 · 固定不滚 —— */
.topbar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx;
  background: var(--bg-elevated);
  border-bottom: 1rpx solid var(--border);
}
.topbar-btn { display: flex; align-items: center; }
.topbar-btn:active { opacity: 0.55; }
.topbar-title { text-align: center; font-size: 32rpx; font-weight: 600; }

/* —— 消息区 —— */
/* flex:1 + min-height:0 是 scroll-view 能被压缩、内部滚动的前提；
   缺 min-height:0 时它会按内容撑大、把底部输入条顶出视口 */
/* 输入条是 in-flow 的 flex 子项（非 fixed 浮层），消息区底部本就贴其顶部，
   无需再留避让空间；此前 120rpx 的 padding-bottom 成了死白（输入框上方那条留白） */
.msgs { flex: 1; min-height: 0; padding: 24rpx; box-sizing: border-box; }
/* 内部容器底部对齐：消息少时贴近输入条、不顶在顶部留大片空白；消息多时自然向下生长可滚动 */
.msgs-inner { min-height: 100%; display: flex; flex-direction: column; justify-content: flex-end; box-sizing: border-box; }
.load-earlier { text-align: center; padding: 12rpx 0 24rpx; color: var(--primary); }
.msg-row { display: flex; margin-bottom: 24rpx; }
.msg-row-user { justify-content: flex-end; }
.bubble {
  max-width: 82%;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  line-height: 1.75;
  box-sizing: border-box;
  word-break: break-word;
  overflow-wrap: anywhere; /* 长串（ISBN/URL）换行，气泡不被撑破 */
}
.bubble-user {
  background: var(--primary);
  color: var(--inverse);
  border-radius: 24rpx 8rpx 24rpx 24rpx;
}
.bubble-ai {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-left: 4rpx solid var(--secondary); /* 批注边距线（签名元素） */
  border-radius: 8rpx 22rpx 22rpx 22rpx;
}
.ai-label {
  display: block;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--text-3);
  margin-bottom: 10rpx;
}
.typing { color: var(--primary); margin-left: 2rpx; }

/* —— 表格片段：原生 WXML 网格 + 卡片内横向滑动（rich-text 的 border/padding 不可靠，改用 CSS 类） —— */
.table-scroll {
  width: 100%;
  margin: 10rpx 0;
  padding: 6rpx;
  background: #ffffff;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}
.grid-table {
  display: inline-flex;
  flex-direction: column;
  border: 1rpx solid #e3ddd3;
  border-radius: 10rpx;
  overflow: hidden;
}
.grid-row { display: flex; flex-direction: row; }
.grid-head { background: #f6f2ec; }
.grid-row.odd { background: #faf8f5; }
.grid-cell {
  flex: 0 0 220rpx;
  min-width: 220rpx;
  padding: 14rpx 16rpx;
  border-right: 1rpx solid #e3ddd3;
  border-bottom: 1rpx solid #e3ddd3;
  font-size: 24rpx;
  line-height: 1.45;
  color: #3a3a36;
  text-align: left;
  box-sizing: border-box;
  word-break: break-word;
}
.grid-row .grid-cell:last-child { border-right: none; }
.grid-row:last-child .grid-cell { border-bottom: none; }
.grid-head .grid-cell {
  color: #3a5a6b;
  font-weight: 600;
}


/* —— 思维链 · 纸面脚注风 —— */
.thinking {
  border-left: 3rpx solid var(--border-strong);
  padding: 8rpx 0 8rpx 18rpx;
  margin-bottom: 16rpx;
}
.thinking-body {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 4rpx;
  white-space: pre-wrap;
}

/* —— 工具调用链 · 卡片化（移动端适配） —— */
.tools { margin: 6rpx 0 14rpx; display: flex; flex-direction: column; gap: 10rpx; }

/* 多工具时的链头说明：细小眉标 + 圆点，不再是大虚线药丸 */
.tool-chain-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 0 4rpx;
  margin-bottom: 2rpx;
}
.chain-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--secondary);
  flex-shrink: 0;
}

/* 单条工具卡：圆角卡片 + 左侧相位色边线（呼应 AI 气泡批注线签名） */
.tool-card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-left: 4rpx solid var(--secondary);
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  overflow: hidden;
}
.tool-card.start { border-left-color: var(--primary); }
.tool-card.end { border-left-color: var(--success); }
.tool-card.error { border-left-color: var(--danger); }

.tool-head { display: flex; align-items: center; gap: 14rpx; }

/* 状态图标装入浅色圆底，窄屏也不挤 */
.tool-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-subtle);
}
.tool-card.start .tool-icon-wrap { background: var(--primary-light); }
.tool-card.end .tool-icon-wrap { background: rgba(125, 146, 112, 0.16); }
.tool-card.error .tool-icon-wrap { background: rgba(168, 90, 74, 0.16); }

/* 文字区：名称与摘要上下叠放，窄屏不挤成一行 */
.tool-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.tool-title-row { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.tool-seq { font-size: 20rpx; color: var(--text-3); flex-shrink: 0; }
.tool-name { font-size: 26rpx; font-weight: 500; color: var(--text); min-width: 0; }
.tool-detail {
  font-size: 22rpx;
  color: var(--text-3);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; /* 窄屏下摘要单行省略，避免把整条工具链挤变形 */
}

/* 展开按钮（仅 end 且有 data）漂浮右侧 */
.tool-toggle { margin-left: auto; padding: 6rpx; display: flex; align-items: center; flex-shrink: 0; }
.tool-toggle.on .tool-chev { transform: rotate(180deg); }

/* 数据抽屉：等宽字体、浅底、可滚动 */
.tool-data {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  background: var(--bg-subtle);
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  max-height: 300rpx;
  overflow: auto;
}
.tool-data-json {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-2);
  white-space: pre-wrap;
  word-break: break-all;
  font-family: monospace;
}
.tool-card.start .tool-icon { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* —— 输入区 · 圆角书写条（固定底部） —— */
.input-bar {
  flex: 0 0 auto;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 14rpx 24rpx 16rpx;
  background: var(--bg-elevated);
  border-top: 1rpx solid var(--border);
}
.chat-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-subtle);
  border: 1rpx solid var(--border);
  border-radius: 36rpx;
  min-height: 72rpx;
  max-height: 200rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text);
}
.ph { color: var(--text-3); }
.send-btn {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary);
  color: var(--inverse);
  display: flex;
  align-items: center;
  justify-content: center;
}
.send-btn:active { background: var(--primary-hover); }
.send-btn.disabled { background: var(--bg-muted); }
.send-btn.stop { background: var(--danger); }

/* —— 会话抽屉 —— */
.drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(44, 40, 37, 0.35);
  z-index: 10;
}
.drawer {
  position: fixed;
  left: -540rpx;
  top: 0;
  bottom: 0;
  width: 520rpx;
  background: var(--bg-elevated);
  z-index: 11;
  transition: left 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  border-right: 1rpx solid var(--border);
}
.drawer-open { left: 0; }
.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}
.drawer-title { font-size: 32rpx; font-weight: 600; }
.link { color: var(--primary); font-size: 26rpx; }
.drawer-list { flex: 1; }
.conv-item {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--bg-muted);
}
.conv-active { background: var(--primary-light); }
.conv-title { font-size: 27rpx; }
.conv-del { padding: 8rpx 12rpx; display: flex; align-items: center; }
