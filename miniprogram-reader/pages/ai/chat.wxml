<view class="chat-page">
  <!-- 会话抽屉 -->
  <view class="drawer-mask" wx:if="{{drawerOpen}}" bindtap="toggleDrawer"></view>
  <view class="drawer {{drawerOpen ? 'drawer-open' : ''}}">
    <view class="drawer-header">
      <text class="drawer-title serif">会话</text>
      <text class="link" bindtap="createConversation">＋ 新建</text>
    </view>
    <scroll-view scroll-y class="drawer-list">
      <view
        wx:for="{{conversations}}"
        wx:key="id"
        class="conv-item {{currentConv && currentConv.id === item.id ? 'conv-active' : ''}}"
      >
        <view class="flex-1 ellipsis conv-title" data-id="{{item.id}}" bindtap="onSelectConv">{{item.titleText}}</view>
        <view class="conv-del" data-id="{{item.id}}" catchtap="onDeleteConv">
          <app-icon name="close" size="24" color="#9c958d" />
        </view>
      </view>
      <view wx:if="{{!conversations.length}}" class="tiny" style="padding:32rpx;text-align:center;">暂无会话</view>
    </scroll-view>
  </view>

  <!-- 顶栏（固定，不随对话滚动） -->
  <view class="topbar">
    <view class="topbar-btn" bindtap="toggleDrawer">
      <app-icon name="menu" size="32" color="#3a5a6b" />
    </view>
    <view class="flex-1 ellipsis topbar-title serif">{{currentConv.titleText || '馆员 AI'}}</view>
    <view class="topbar-btn" bindtap="createConversation">
      <app-icon name="plus" size="32" color="#3a5a6b" />
    </view>
  </view>

  <!-- 目录定位条（轮次 ≥3 才出现；面板原位展开把对话推下去，不遮挡） -->
  <view class="navstrip" wx:if="{{navRounds.length >= 3}}">
    <view class="ns-head">
      <!-- 独立热区：仅「目录」开合面板，避免点 tick 误触展开 -->
      <view class="ns-toggle" bindtap="onToggleToc">
        <text class="ns-cap serif">目录</text>
        <app-icon class="ns-caret {{tocOpen ? 'open' : ''}}" name="chevron-down" size="20" color="#9c958d" />
      </view>
      <scroll-view
        class="ns-ticks"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        scroll-into-view="tick-{{navCurrent}}"
        scroll-with-animation
      >
        <view class="ns-ticks-in">
          <!-- 弹性占位：tick 少时撑开把数字推到右侧；tick 多时收缩为 0，溢出全在右侧、全部可达 -->
          <view class="ns-spacer"></view>
          <text
            wx:for="{{navRounds}}"
            wx:key="msgId"
            id="tick-{{index}}"
            class="ns-tick {{index === navCurrent ? 'cur' : ''}}"
            data-idx="{{index}}"
            bindtap="onNavJump"
          >{{item.no}}</text>
        </view>
      </scroll-view>
    </view>
    <!-- 外层 view 负责展开/收起过渡（普通 view 过渡各端一致）；内层 scroll-view 固定限高内滚，
         锚点瞬时定位不带滚动动画，避免展开时内容先上跳再下落 -->
    <view class="tocp {{tocOpen ? 'open' : ''}}">
      <scroll-view class="tocp-scroll" scroll-y scroll-into-view="{{tocAnchor}}">
        <view
          wx:for="{{navRounds}}"
          wx:key="msgId"
          id="tocrow-{{index}}"
          class="toc-row {{index === navCurrent ? 'cur' : ''}}"
          data-idx="{{index}}"
          bindtap="onNavJump"
        >
          <text class="toc-no">№{{item.no}}</text>
          <text class="toc-ex">{{item.excerpt}}</text>
          <view class="toc-lead"></view>
          <text class="toc-time">{{item.time}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 消息区（仅此处滚动；顶栏/输入条固定；bindscroll 驱动当前轮高亮跟随） -->
  <scroll-view scroll-y class="msgs" scroll-into-view="{{scrollInto}}" scroll-with-animation bindscroll="onMsgsScroll">
    <view class="msgs-inner {{!messages.length && !loadingHistory ? 'is-empty' : ''}}">
    <view wx:if="{{hasMoreHistory}}" class="tiny load-earlier" bindtap="loadEarlier">
      {{loadingHistory ? '加载中…' : '加载更早消息'}}
    </view>

    <!-- 空态 · 藏书票：无消息且不在加载中 -->
    <view wx:if="{{!messages.length && !loadingHistory}}" class="exlib">
      <view class="exlib-frame">
        <view class="exlib-core">
          <view class="exlib-spark"><text class="spark-txt">✦</text></view>
          <text class="exlib-title serif">新的谈话</text>
          <text class="exlib-sub">这一页还没有字迹，从任何一句开始</text>
          <view class="exlib-toc">
            <view class="exlib-row" data-q="我有哪些书快到期了？" bindtap="onSuggest">
              <text class="er-txt">我有哪些书快到期了？</text>
              <view class="er-dots"></view>
              <text class="er-go">→</text>
            </view>
            <view class="exlib-row" data-q="当前的借阅额度是多少？" bindtap="onSuggest">
              <text class="er-txt">当前的借阅额度是多少？</text>
              <view class="er-dots"></view>
              <text class="er-go">→</text>
            </view>
            <view class="exlib-row" data-q="逾期罚款怎么算？" bindtap="onSuggest">
              <text class="er-txt">逾期罚款怎么算？</text>
              <view class="er-dots"></view>
              <text class="er-go">→</text>
            </view>
          </view>
          <text class="exlib-foot">EX LIBRIS · 馆员 AI</text>
        </view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
      <!-- 跨天日期戳：细线夹注 -->
      <view wx:if="{{item.dayLabel}}" class="day-sep">
        <view class="day-line"></view>
        <text class="day-txt serif">{{item.dayLabel}}</text>
        <view class="day-line"></view>
      </view>
      <!-- 用户：轮次眉标 + 靠右 -->
      <block wx:if="{{item.role === 'user'}}">
        <view wx:if="{{item.roundNo}}" class="rnd">
          <text class="rnd-no">№{{item.roundNo}}</text>
          <text wx:if="{{item.timeText}}" class="rnd-time">{{item.timeText}} 问</text>
        </view>
        <view class="msg-row msg-row-user">
          <view class="bubble bubble-user"><text user-select>{{item.content}}</text></view>
        </view>
      </block>
      <!-- AI：靠左，批注边距线 + 馆员 AI 小标 -->
      <view wx:else class="msg-row">
        <view class="bubble bubble-ai">
          <text class="ai-label">馆员 AI</text>

          <!-- 深度思考（折叠可展开） -->
          <view wx:if="{{item.thinking}}" class="thinking" data-id="{{item.id}}" bindtap="toggleThinking">
            <text class="eyebrow">THOUGHT</text>
            <view class="thinking-body">{{item.thinkingOpen ? item.thinking : '深度思考已折叠，点击展开'}}</view>
          </view>

          <!-- 工具调用链（流式期间展示完整卡片；收拢为徽章后隐藏，见下方 .chips） -->
          <view wx:if="{{item.toolEvents.length && !item.toolChips.length}}" class="tools">
            <view wx:if="{{item.toolEvents.length >= 2}}" class="tool-chain-head">
              <text class="chain-dot" />
              <text>本次调用了 {{item.toolEvents.length}} 个工具</text>
            </view>
            <view
              wx:for="{{item.toolEvents}}"
              wx:for-item="tool"
              wx:for-index="ti"
              wx:key="index"
              class="tool-card {{tool.phase}}"
            >
              <view class="tool-head">
                <view class="tool-icon-wrap">
                  <app-icon
                    class="tool-icon"
                    name="{{tool.phase === 'start' ? 'clock' : (tool.phase === 'error' ? 'x-circle' : 'check-circle')}}"
                    size="22"
                    color="{{tool.phase === 'start' ? '#c4904a' : (tool.phase === 'error' ? '#a85a4a' : '#7a9270')}}"
                  />
                </view>
                <view class="tool-body">
                  <view class="tool-title-row">
                    <text class="tool-seq">{{ti + 1}}</text>
                    <text class="tool-name">{{tool.label}}</text>
                  </view>
                  <text wx:if="{{tool.detail}}" class="tool-detail">{{tool.detail}}</text>
                </view>
                <view
                  wx:if="{{tool.phase === 'end' && tool.data}}"
                  class="tool-toggle {{tool.expanded ? 'on' : ''}}"
                  data-id="{{item.id}}"
                  data-ti="{{ti}}"
                  bindtap="toggleToolData"
                >
                  <app-icon class="tool-chev" name="chevron-down" size="20" color="#9c958d" />
                </view>
              </view>
              <view wx:if="{{tool.expanded && tool.data}}" class="tool-data">
                <text user-select class="tool-data-json">{{tool.data}}</text>
              </view>
            </view>
          </view>

          <!-- 参考资料：本轮知识库检索命中的来源（SSE rag 事件在调用 LLM 前推送，故先于正文出现）；
               后端不落库，历史消息无此块。点药丸展开该片段摘要 -->
          <view wx:if="{{item.ragSources.length}}" class="refs">
            <view class="refs-row">
              <view class="refs-label">
                <app-icon class="refs-icon" name="scroll" size="22" color="#9c958d" />
                <text class="refs-txt">参考资料</text>
              </view>
              <view
                wx:for="{{item.ragSources}}"
                wx:for-item="ref"
                wx:for-index="ri"
                wx:key="index"
                class="ref-chip {{item.ragOpen === ri ? 'on' : ''}}"
                data-id="{{item.id}}"
                data-ri="{{ri}}"
                bindtap="onRefTap"
              >
                <view class="ref-dot"></view>
                <text class="ref-title">{{ref.docTitle}}</text>
              </view>
            </view>
            <view wx:if="{{item.refSnippet}}" class="ref-snap">
              <text class="ref-snap-head">{{item.refTitle}} · 检索片段摘要</text>
              <text user-select class="ref-snap-body">{{item.refSnippet}}</text>
            </view>
          </view>

          <!-- 正文：流式时逐字显示 shown + 光标；结束切片段渲染（表格片段可卡片内横滑） -->
          <block wx:if="{{!item.pending && item.segments.length}}">
            <block wx:for="{{item.segments}}" wx:for-item="seg" wx:key="index">
              <rich-text wx:if="{{seg.type === 'rich'}}" nodes="{{seg.html}}"></rich-text>
              <scroll-view wx:else scroll-x="true" class="table-scroll">
                <view class="grid-table">
                  <view class="grid-row grid-head">
                    <view wx:for="{{seg.table.headers}}" wx:for-item="h" wx:key="index" class="grid-cell">{{h}}</view>
                  </view>
                  <view
                    wx:for="{{seg.table.rows}}"
                    wx:for-item="row"
                    wx:for-index="ri"
                    wx:key="index"
                    class="grid-row {{ri % 2 === 1 ? 'odd' : ''}}"
                  >
                    <view wx:for="{{row}}" wx:for-item="c" wx:key="index" class="grid-cell">{{c}}</view>
                  </view>
                </view>
              </scroll-view>
            </block>
          </block>
          <text wx:elif="{{!item.pending && item.content}}" user-select>{{item.content}}</text>
          <text wx:else user-select>{{item.shown}}</text>
          <text wx:if="{{item.pending}}" class="typing">▍</text>

          <!-- 工具徽章行：回复生成完毕后，工具卡片收拢为一排徽章（金色圆点 + 中文名 ×次数） -->
          <view wx:if="{{item.toolChips.length}}" class="chips">
            <view
              wx:for="{{item.toolChips}}"
              wx:for-item="chip"
              wx:key="name"
              class="chip {{item.snapTool === chip.name ? 'on' : ''}}"
              data-id="{{item.id}}"
              data-name="{{chip.name}}"
              bindtap="onChipTap"
            >
              <view class="chip-dot"></view>
              <text class="chip-name">{{chip.label}}</text>
              <text wx:if="{{chip.count > 1}}" class="chip-n">×{{chip.count}}</text>
            </view>
          </view>
          <!-- 徽章快照抽屉：点徽章展开该工具最近一次返回的数据（历史徽章为纯标签，点开无动作） -->
          <view wx:if="{{item.snapData}}" class="chip-snap">
            <text user-select class="tool-data-json">{{item.snapData}}</text>
          </view>
        </view>
      </view>
    </view>
    <view id="msg-bottom-{{scrollTick}}" style="height:2rpx;"></view>
    </view>
  </scroll-view>

  <!-- 输入区（普通流 flex 子项；键盘弹出时整体上移，避免被遮挡） -->
  <view class="input-bar" style="transform: translateY(-{{kbOffset}}px);">
    <!-- 用 textarea 支持多行：换行键真正换行（confirm-type=return），发送走右侧圆形按钮 -->
    <textarea
      class="chat-input"
      value="{{input}}"
      bindinput="onInput"
      bindkeyboardheightchange="onKeyboardHeightChange"
      confirm-type="return"
      auto-height
      maxlength="-1"
      show-confirm-bar="{{false}}"
      cursor-spacing="16"
      placeholder="{{streaming ? '馆员 AI 正在回复…' : '问问馆员 AI…'}}"
      placeholder-class="ph"
      disabled="{{streaming}}"
      adjust-position="{{false}}"
    />
    <view
      wx:if="{{streaming}}"
      class="send-btn stop"
      bindtap="stop"
    >
      <app-icon name="close" size="30" color="#faf8f5" />
    </view>
    <view
      wx:else
      class="send-btn {{input ? '' : 'disabled'}}"
      bindtap="send"
    >
      <app-icon name="arrow-up" size="34" color="#faf8f5" />
    </view>
  </view>
</view>
