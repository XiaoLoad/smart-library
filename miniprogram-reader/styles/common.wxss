/* ===== 通用层：卡片 / 标签 / 按钮 / 单元格 / 表单 =====
 * 由 app.wxss @import 引入，依赖 base.wxss 中的设计令牌。
 */

.page { padding: 36rpx 28rpx calc(var(--tabbar-h) + env(safe-area-inset-bottom)); }

/* —— 卡片 · 细边框无重阴影 —— */
.card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* —— 标题 · 宋体 —— */
.section-title {
  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', serif;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* —— 细分割线 —— */
.hr { height: 1rpx; background: var(--border); margin: 24rpx 0; }

/* —— 标签 · 克制方角（对齐 el-tag） ——
   注意：必须用 inline-block + nowrap（不可用 flex），且需嵌在 <view> 中；
   <text> 不支持 flex 布局，flex 压缩下 CJK 会逐字换行导致徽章被拉成竖条 */
.badge {
  display: inline-block;
  white-space: nowrap;
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  line-height: 1.7;
  border: 1rpx solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-2);
}
.badge-blue { background: var(--primary-light); color: var(--primary); border-color: #d4dfe4; }
.badge-green { background: var(--secondary-light); color: var(--secondary); border-color: #dde5d6; }
.badge-orange { background: #f6ede0; color: var(--warning); border-color: #ecdcc3; }
.badge-red { background: #f2e7e3; color: var(--danger); border-color: #e5d2cc; }
.badge-gray { background: var(--bg-subtle); color: var(--text-2); }
/* 中性进行态：与 badge-blue（靛蓝）区分，避免与「待取书」的陶土黄同色异义 */
.badge-info { background: #eef1f3; color: #5a7a8c; border-color: #dbe3e7; }

/* —— 按钮 · 无满屏主按钮 —— */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 6rpx;
  font-size: 27rpx;
  font-weight: 500;
  height: 78rpx;
  padding: 0 36rpx;
  border: 1rpx solid transparent;
  line-height: 1;
}
.btn::after { border: none; }
.btn-primary { background: var(--primary); color: var(--inverse); }
.btn-primary[disabled] { background: var(--bg-muted); color: var(--text-3); }
.btn-outline { background: transparent; border-color: var(--border-strong); color: var(--text-2); }
.btn-outline[disabled] { color: var(--text-3); border-color: var(--border); }
.btn-quiet { background: transparent; color: var(--primary); }
.btn-danger-quiet { background: transparent; color: var(--danger); }
.btn-mini { height: 56rpx; font-size: 24rpx; padding: 0 24rpx; }
.btn-block { display: flex; width: 100%; }

/* —— 单元格 —— */
.cells {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--divider, #ece6dd);
}
.cell:last-child { border-bottom: none; }
.cell-arrow { color: var(--text-3); }
.cell-label { flex: 1; }

/* —— 表单 —— */
.field { margin-bottom: 28rpx; }
.field-label {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--text-3);
  margin-bottom: 10rpx;
}
.field-input {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 6rpx;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  color: var(--text);
}
